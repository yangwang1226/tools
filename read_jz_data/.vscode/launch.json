{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python: FastAPI 应用 (Dev环境)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/app.py",
            "console": "integratedTerminal",
            "justMyCode": false,
            "args": ["--env=dev"],
            "env": {
                "PYTHONPATH": "${workspaceFolder}",
                "ENV": "dev"
            },
            "stopOnEntry": false,
            "redirectOutput": true
        },
        {
            "name": "Python: FastAPI 应用 (Test环境)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/app.py",
            "console": "integratedTerminal",
            "justMyCode": false,
            "args": ["--env=test"],
            "env": {
                "PYTHONPATH": "${workspaceFolder}",
                "ENV": "test1"
            },
            "stopOnEntry": false,
            "redirectOutput": true
        }
    ]
}